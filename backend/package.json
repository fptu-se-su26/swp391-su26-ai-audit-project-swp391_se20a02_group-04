{
  "name": "motorcycle-repair-booking-backend",
  "version": "1.0.0",
  "description": "Backend API for Motorcycle Repair Shop Appointment Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:reset": "npm run kill:5000 && npm run dev",
    "kill:5000": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/kill-port.ps1 -Port 5000",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "seed:roles": "node src/scripts/seedRoles.js",
    "seed:data": "node src/scripts/seedData.js",
    "seed:staff": "node src/scripts/seedStaffTestData.js",
    "seed:inventory": "node src/scripts/seedMotorcycleInventory.js",
    "seed:inventory-images": "node src/scripts/updateInventoryImages.js",
    "seed:services": "node src/scripts/seedGarageServices.js",
    "migrate:appointments": "node src/scripts/migrateAppointmentManagement.js"
  },
  "keywords": [
    "appointment",
    "booking",
    "motorcycle",
    "repair"
  ],
  "author": "Group 4 - SE20A02",
  "license": "ISC",
  "dependencies": {
    "@payos/node": "^2.0.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
